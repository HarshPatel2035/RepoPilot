# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
DATABASE_URL=postgresql://repopilot:repopilot@localhost:5432/repopilot
# Optional: cross-encoder reranking (better ranking, ~2 s slower per question on CPU)
RERANK=false
# Optional: most tool calls the agent may make before it must answer
AGENT_MAX_TOOL_ROUNDS=6
# Optional: GitHub token for draft-reply, raises the 60 requests/hour unauthenticated limit
GITHUB_TOKEN=
